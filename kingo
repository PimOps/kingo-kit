#!/usr/bin/env bash
set -Eeuo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" == /* ]] || script_path="$script_dir/$script_path"
done
repo_dir="$(cd "$(dirname "$script_path")" && pwd)"
cd "$repo_dir"
# shellcheck source=scripts/lib/install-common.sh
source "$repo_dir/scripts/lib/install-common.sh"

if [[ -f "$repo_dir/.kingokit-installed" ]]; then
  state_dir="${KINGOKIT_STATE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/kingokit}"
else
  state_dir="${KINGOKIT_STATE_DIR:-$repo_dir}"
fi
mkdir -p "$state_dir"
env_file="$state_dir/.env"

# This is also an idempotent migration step for credentials introduced by a
# newer Kingo Kit version; existing values are never rotated.
if [[ -f "$env_file" ]]; then
  KINGOKIT_ENV_FILE="$env_file" "$repo_dir/scripts/generate-env.sh" >/dev/null
else
  KINGOKIT_ENV_FILE="$env_file" "$repo_dir/scripts/generate-env.sh"
fi
export KINGOKIT_ENV_FILE="$env_file"
# Values generated by this project are shell-safe hex strings. Loading .env lets
# the URL and credential commands use any instructor-customized port values.
set -a
# shellcheck disable=SC1091
source "$env_file"
set +a

shared_dir="${KINGOKIT_SHARED_DIR:-$HOME/Kingokit}"
create_shared_folder "$shared_dir"
export KINGOKIT_SHARED_DIR="$shared_dir"

compose=(docker compose --project-directory "$repo_dir" --env-file "$env_file")

usage() {
  cat <<'EOF'
Usage: kingo COMMAND [arguments]

Commands:
  up              Start or update all classroom services
  down            Stop services, preserving all data
  restart         Restart all services
  status          Show container health and state
  logs [service]  Follow logs for all services or one service
  urls            Show browser URLs and local login information
  credentials     Show database and application credentials from .env
  mcp             Show Jupyter MCP connection settings
  doctor          Diagnose Docker access and installation status
  health SERVICE  Show container health details and recent service logs
  docker ARGS...  Run a Docker command with Kingo's group-access fallback
  app NAME ACTION Manage one app: up, down, restart, status, or logs
  samples         Load/retry AdventureWorks and WideWorldImportersDW
  psql            Open psql in the warehouse as the postgres administrator
  reset --yes     Factory-reset the apps and start a fresh stack
  uninstall       Remove Kingo Kit after confirmation (keeps ~/Kingokit)
                  Add --keep-images (or -keepimages) to retain Docker images
EOF
}

ensure_kingo_network() {
  if ! docker network inspect kingo-kit >/dev/null 2>&1; then
    docker network create kingo-kit >/dev/null
  fi
}

ensure_container_names_available() {
  local expected_project="${COMPOSE_PROJECT_NAME:-kingo-kit}" name owner
  for name in "$@"; do
    if docker container inspect "$name" >/dev/null 2>&1; then
      owner="$(docker container inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$name" 2>/dev/null || true)"
      if [[ "$owner" != "$expected_project" ]]; then
        echo "Container name '$name' is already used outside Kingo Kit." >&2
        echo "Kingo Kit will not modify it. Rename or remove that container, then retry." >&2
        return 1
      fi
    fi
  done
}

reconcile_postgres() {
  "${compose[@]}" exec -T postgres \
    /docker-entrypoint-initdb.d/10-kingo-init.sh >/dev/null
  "${compose[@]}" exec -T postgres \
    psql --username postgres --dbname postgres --set ON_ERROR_STOP=1 \
    --file /docker-entrypoint-initdb.d/20-required-extensions.sql >/dev/null
}

run_app() {
  local app_name="${1:-}" action="${2:-status}"
  case "$app_name" in
    postgres|jupyter|jupyter-mcp|langflow|n8n|metabase|cloudbeaver|qdrant) ;;
    *)
      echo "Unknown app: ${app_name:-<missing>}" >&2
      echo "Available apps: postgres, jupyter, jupyter-mcp, langflow, n8n, metabase, cloudbeaver, qdrant" >&2
      exit 2
      ;;
  esac
  case "$action" in
    up|down|restart|status|logs) ;;
    *) echo "Unknown app action: $action" >&2; exit 2 ;;
  esac

  ensure_docker_access app "$app_name" "$action"
  ensure_kingo_network
  local app_file="$repo_dir/apps/$app_name/compose.yaml"
  local app_compose=(docker compose --project-name "${COMPOSE_PROJECT_NAME:-kingo-kit}" --env-file "$env_file" -f "$app_file")
  case "$action" in
    up)
      ensure_container_names_available "kingo-$app_name"
      if [[ "$app_name" == "jupyter-mcp" ]]; then
        "${compose[@]}" up -d --build --wait --wait-timeout 180 jupyter
      fi
      if [[ "$app_name" == "metabase" ]]; then
        ensure_container_names_available kingo-metabase-init
        "${compose[@]}" up -d --build --wait --wait-timeout 180 postgres
        reconcile_postgres
      fi
      if [[ "$app_name" == "n8n" ]]; then
        ensure_container_names_available kingo-n8n-init
      fi
      "${app_compose[@]}" up -d --build
      ;;
    down) "${app_compose[@]}" down ;;
    restart) "${app_compose[@]}" restart ;;
    status) "${app_compose[@]}" ps ;;
    logs) "${app_compose[@]}" logs --follow --tail=100 ;;
  esac
}

ensure_docker_access() {
  if docker info >/dev/null 2>&1; then
    return
  fi

  local current_user account_groups session_groups docker_error host_os
  current_user="$(id -un)"
  host_os="$(uname -s)"
  # Supplying the username asks the account database, so this sees a newly
  # assigned supplementary group even when the current shell predates it.
  account_groups="$(id -nG "$current_user" 2>/dev/null || true)"
  session_groups="$(id -nG 2>/dev/null || true)"
  if [[ "${KINGO_GROUP_REEXEC:-0}" != "1" ]] \
    && [[ " ${account_groups} " == *" docker "* ]] \
    && command -v sg >/dev/null 2>&1; then
    printf -v reexec_command '%q ' "$repo_dir/kingo" "$@"
    exec sg docker -c "KINGO_GROUP_REEXEC=1 $reexec_command"
  fi

  docker_error="$(docker info 2>&1 | tail -n 3 || true)"
  echo "Kingo Kit cannot access the Docker daemon." >&2
  if [[ "$host_os" == "Darwin" ]]; then
    echo "On macOS, start Docker Desktop and wait until it reports that Docker is running." >&2
    echo "Docker group changes and sudo are not needed on macOS." >&2
  elif [[ " ${account_groups} " != *" docker "* ]]; then
    echo "The account '${current_user}' is not assigned to the docker group." >&2
    echo "Repair it once with: sudo usermod -aG docker ${current_user}" >&2
    echo "Then reboot Ubuntu (a reboot avoids stale desktop login sessions)." >&2
  elif [[ " ${session_groups} " != *" docker "* ]]; then
    echo "The account is assigned to docker, but this login session has stale groups." >&2
    echo "Activate it now with: newgrp docker" >&2
    echo "Then rerun the command inside the new shell." >&2
  else
    echo "The account is assigned to the docker group, so this is a daemon or socket problem." >&2
    echo "Run './kingo doctor' for the exact state." >&2
  fi
  [[ -z "$docker_error" ]] || printf 'Docker reported:\n%s\n' "$docker_error" >&2
  exit 1
}

doctor() {
  local current_user account_groups session_groups docker_accessible=false host_os
  current_user="$(id -un)"
  host_os="$(uname -s)"
  echo "Host OS:         ${host_os}"
  account_groups="$(id -nG "$current_user" 2>/dev/null || true)"
  session_groups="$(id -nG 2>/dev/null || true)"
  echo "User:            ${current_user}"
  echo "Account groups:  ${account_groups:-unavailable}"
  echo "Session groups:  ${session_groups:-unavailable}"
  echo "Group helper:    $(command -v sg 2>/dev/null || echo missing)"
  echo "Docker CLI:      $(command -v docker 2>/dev/null || echo missing)"
  if docker compose version >/dev/null 2>&1; then
    echo "Docker Compose:  available"
  else
    echo "Docker Compose:  unavailable"
  fi
  if command -v systemctl >/dev/null 2>&1; then
    echo "Docker service:  $(systemctl is-active docker 2>/dev/null || echo unavailable)"
  fi
  if [[ -S /var/run/docker.sock ]]; then
    echo "Docker socket:   $(ls -l /var/run/docker.sock)"
  else
    echo "Docker socket:   missing"
  fi
  if docker info >/dev/null 2>&1; then
    docker_accessible=true
    echo "Docker API:      accessible"
  else
    echo "Docker API:      inaccessible"
    docker info 2>&1 | tail -n 3 || true
  fi

  if [[ "$docker_accessible" == false ]]; then
    echo
    if [[ "$host_os" == "Darwin" ]]; then
      echo "Diagnosis: Docker Desktop is stopped, still starting, or its socket is inaccessible."
      echo "Start Docker Desktop; do not add a macOS account to a docker group."
    elif [[ " ${account_groups} " == *" docker "* ]] && [[ " ${session_groups} " != *" docker "* ]]; then
      echo "Diagnosis: the account is configured correctly, but this login session is stale."
      echo "Run 'newgrp docker' now, or fully sign out of Ubuntu and sign in again."
    elif [[ " ${account_groups} " != *" docker "* ]]; then
      echo "Diagnosis: the account has not been added to the docker group."
    else
      echo "Diagnosis: group membership is active; inspect the daemon and socket error above."
    fi
  fi
}

show_health() {
  local service="${1:-}"
  if [[ -z "$service" ]]; then
    echo "Usage: ./kingo health SERVICE" >&2
    exit 2
  fi
  if ! "${compose[@]}" config --services | grep -Fxq "$service"; then
    echo "Unknown service: $service" >&2
    exit 2
  fi

  local container_id
  container_id="$("${compose[@]}" ps --all --quiet "$service")"
  if [[ -z "$container_id" ]]; then
    echo "No container exists for service '$service'. Start the stack with: ./kingo up" >&2
    exit 1
  fi

  echo "Container state:"
  docker inspect --format 'Status: {{.State.Status}}
Running: {{.State.Running}}
Exit code: {{.State.ExitCode}}
Error: {{if .State.Error}}{{.State.Error}}{{else}}none{{end}}
Health: {{if .State.Health}}{{.State.Health.Status}}{{else}}not configured{{end}}
{{if .State.Health}}Recent health checks:
{{range .State.Health.Log}}- {{.Start}} (exit {{.ExitCode}})
  {{.Output}}{{end}}{{end}}' "$container_id"
  echo
  echo "Recent $service logs:"
  "${compose[@]}" logs --no-color --tail=100 "$service"
}

start_stack() {
  local web_services=(
    jupyter jupyter-mcp langflow n8n metabase cloudbeaver qdrant
  )

  ensure_container_names_available \
    kingo-postgres kingo-jupyter kingo-jupyter-mcp kingo-langflow kingo-n8n kingo-n8n-init \
    kingo-metabase kingo-metabase-init kingo-cloudbeaver kingo-qdrant
  ensure_kingo_network

  echo "[1/2] Starting PostgreSQL..."
  "${compose[@]}" up -d --build --wait --wait-timeout 180 postgres
  reconcile_postgres

  echo "[2/2] Starting web applications..."
  # Start the complete non-profile stack so one-shot helpers such as
  # metabase-init still run, then wait only for the long-running applications.
  "${compose[@]}" up -d --build
  "${compose[@]}" up -d --wait --wait-timeout 300 "${web_services[@]}"
  echo "All Kingo Kit applications are running."
}

confirm_uninstall() {
  local assume_yes="$1" keep_images="$2"
  if [[ "$assume_yes" == true ]]; then
    return
  fi
  if [[ ! -t 0 ]]; then
    echo "Uninstall needs confirmation. Run: kingo uninstall --yes" >&2
    return 1
  fi
  if [[ "$keep_images" == true ]]; then
    echo "This removes all Kingo Kit containers, volumes, network, credentials, and installed application files."
    echo "Downloaded and locally built Docker images will be retained for a faster reinstall."
  else
    echo "This removes all Kingo Kit containers, images, volumes, network, credentials, and installed application files."
  fi
  echo "Student files in $shared_dir will be retained."
  echo "Docker Desktop/Docker Engine will NOT be uninstalled."
  printf "Type 'uninstall' to continue: "
  local answer
  read -r answer
  [[ "$answer" == "uninstall" ]] || {
    echo "Uninstall cancelled."
    return 1
  }
}

validate_installation_target() {
  [[ -f "$repo_dir/.kingokit-installed" ]] || return 0
  if [[ -z "$repo_dir" || "$repo_dir" == "/" || "$repo_dir" == "$HOME" \
    || ! -f "$repo_dir/compose.yaml" || ! -f "$repo_dir/kingo" ]]; then
    echo "Refusing to remove an unsafe or incomplete installation path: $repo_dir" >&2
    return 1
  fi
}

remove_installed_files() {
  if [[ ! -f "$repo_dir/.kingokit-installed" ]]; then
    rm -f "$env_file"
    echo "This command is running from a development clone; the repository was retained."
    return
  fi

  local user_command="$HOME/.local/bin/kingo"
  if [[ -L "$user_command" ]]; then
    local user_target
    user_target="$(readlink "$user_command")"
    [[ "$user_target" == "$repo_dir/kingo" ]] && rm -f "$user_command"
  fi
  if [[ -L /usr/local/bin/kingo ]]; then
    local system_target
    system_target="$(readlink /usr/local/bin/kingo)"
    if [[ "$system_target" == "$repo_dir/kingo" ]]; then
      if [[ -w /usr/local/bin ]]; then
        rm -f /usr/local/bin/kingo
      else
        sudo rm -f /usr/local/bin/kingo
      fi
    fi
  fi

  rm -f "$env_file"
  rmdir "$state_dir" 2>/dev/null || true
  if [[ -w "$(dirname "$repo_dir")" ]]; then
    rm -rf -- "$repo_dir"
  else
    sudo rm -rf -- "$repo_dir"
  fi
}

uninstall_kingo() {
  local assume_yes=false keep_images=false arg
  for arg in "${@:2}"; do
    case "$arg" in
      --yes) assume_yes=true ;;
      --keep-images|-keepimages|--keepimages) keep_images=true ;;
      *)
        echo "Unknown uninstall option: $arg" >&2
        echo "Usage: kingo uninstall [--keep-images] [--yes]" >&2
        return 2
        ;;
    esac
  done

  confirm_uninstall "$assume_yes" "$keep_images" || return
  validate_installation_target || return
  ensure_docker_access "$@"

  local down_args=(--profile samples down --volumes --remove-orphans)
  if [[ "$keep_images" == false ]]; then
    down_args+=(--rmi all)
  fi
  if ! "${compose[@]}" "${down_args[@]}"; then
    echo "Docker could not remove every Kingo Kit resource." >&2
    echo "The Kingo command and application files were retained so you can retry." >&2
    return 1
  fi
  local network_retained=false
  if docker network inspect kingo-kit >/dev/null 2>&1; then
    if ! docker network rm kingo-kit >/dev/null; then
      network_retained=true
      echo "Warning: the kingo-kit network is still used by another container." >&2
    fi
  fi

  remove_installed_files
  echo
  echo "Kingo Kit's Docker stack and local credentials were removed."
  if [[ "$keep_images" == true ]]; then
    echo "Docker images were retained for a faster reinstall."
  fi
  echo "Docker Desktop/Docker Engine was NOT uninstalled."
  echo "Student files were retained in: $shared_dir"
  if [[ "$network_retained" == true ]]; then
    echo "The shared kingo-kit network could not be removed because another container still uses it." >&2
    return 1
  fi
}

host_for_urls="localhost"
if [[ "${BIND_ADDRESS:-127.0.0.1}" == "0.0.0.0" ]]; then
  host_for_urls="$(hostname -I 2>/dev/null | awk '{print $1}')"
  host_for_urls="${host_for_urls:-localhost}"
fi

case "${1:-}" in
  up)
    ensure_docker_access "$@"
    start_stack
    ;;
  down) ensure_docker_access "$@"; "${compose[@]}" down ;;
  restart) ensure_docker_access "$@"; "${compose[@]}" restart ;;
  status) ensure_docker_access "$@"; "${compose[@]}" ps ;;
  logs) ensure_docker_access "$@"; shift; "${compose[@]}" logs --follow --tail=100 "$@" ;;
  urls)
    cat <<EOF
JupyterLab:  http://${host_for_urls}:${JUPYTER_PORT:-8888}  (no login required)
Jupyter MCP: http://${host_for_urls}:${JUPYTER_MCP_PORT:-4040}/mcp  (Bearer token required)
Langflow:    http://${host_for_urls}:${LANGFLOW_PORT:-7860}
n8n:         http://${host_for_urls}:${N8N_PORT:-5678}  (${N8N_OWNER_EMAIL})
Metabase:    http://${host_for_urls}:${METABASE_PORT:-3000}  (${METABASE_ADMIN_EMAIL})
CloudBeaver: http://${host_for_urls}:${CLOUDBEAVER_PORT:-8978}  (${CLOUDBEAVER_ADMIN_USER:-kingouser})
Qdrant UI:   http://${host_for_urls}:${QDRANT_HTTP_PORT:-6333}/dashboard
PostgreSQL:  ${host_for_urls}:${POSTGRES_PORT:-5432} / warehouse
EOF
    ;;
  credentials)
    cat <<EOF
PostgreSQL database: warehouse
PostgreSQL host from containers: kingo-postgres:5432
PostgreSQL host from Ubuntu/host: ${host_for_urls}:${POSTGRES_PORT:-5432}
Student database login: ${STUDENT_DB_USER:-kingouser} / ${STUDENT_DB_PASSWORD}
Jupyter MCP bearer token: ${JUPYTER_MCP_TOKEN}
Langflow fallback login: ${LANGFLOW_SUPERUSER:-kingouser} / ${LANGFLOW_SUPERUSER_PASSWORD}
n8n web login: ${N8N_OWNER_EMAIL} / ${N8N_OWNER_PASSWORD}
Metabase web login: ${METABASE_ADMIN_EMAIL} / ${METABASE_ADMIN_PASSWORD}
CloudBeaver web login: ${CLOUDBEAVER_ADMIN_USER:-kingouser} / ${CLOUDBEAVER_ADMIN_PASSWORD}
EOF
    ;;
  mcp)
    cat <<EOF
Jupyter MCP endpoint: http://${host_for_urls}:${JUPYTER_MCP_PORT:-4040}/mcp
Authorization header: Bearer ${JUPYTER_MCP_TOKEN}

Claude Code example:
claude mcp add kingo-jupyter --transport http http://${host_for_urls}:${JUPYTER_MCP_PORT:-4040}/mcp --header "Authorization: Bearer ${JUPYTER_MCP_TOKEN}"
EOF
    ;;
  doctor) doctor ;;
  health)
    if [[ -z "${2:-}" ]]; then
      echo "Usage: ./kingo health SERVICE" >&2
      exit 2
    fi
    ensure_docker_access "$@"
    show_health "$2"
    ;;
  docker)
    shift
    if [[ "$#" -eq 0 ]]; then
      echo "Usage: ./kingo docker ARGS..." >&2
      exit 2
    fi
    ensure_docker_access docker "$@"
    docker "$@"
    ;;
  app) shift; run_app "$@" ;;
  samples)
    ensure_docker_access "$@"
    ensure_kingo_network
    "${compose[@]}" up -d --wait --wait-timeout 180 postgres
    reconcile_postgres
    ensure_container_names_available kingo-adventureworks-source kingo-sample-loader
    "${compose[@]}" --profile samples run --name kingo-sample-loader --rm --build sample-loader
    "${compose[@]}" --profile samples stop adventureworks-source >/dev/null
    ;;
  psql)
    ensure_docker_access "$@"
    "${compose[@]}" exec postgres psql -U postgres -d warehouse
    ;;
  reset)
    if [[ "${2:-}" != "--yes" ]]; then
      echo "This factory reset permanently deletes Kingo Kit databases, app settings, and workflows, then starts a fresh stack." >&2
      echo "Run 'kingo reset --yes' only if that is what you want." >&2
      exit 2
    fi
    ensure_docker_access "$@"
    "${compose[@]}" --profile samples down --volumes --remove-orphans
    start_stack
    echo "Factory reset complete. Shared files in $shared_dir were preserved."
    ;;
  uninstall) uninstall_kingo "$@" ;;
  unistall)
    echo "The command is spelled 'kingo uninstall'. Running it now..." >&2
    shift
    uninstall_kingo uninstall "$@"
    ;;
  -h|--help|help|"") usage ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
