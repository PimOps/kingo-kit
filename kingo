#!/usr/bin/env bash
set -Eeuo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_dir"

# Docker group changes normally require a new login session. If bootstrap has
# already added this account to the group but the current shell predates that
# change, transparently re-run this command with the docker group activated.
if ! docker info >/dev/null 2>&1; then
  current_user="$(id -un)"
  docker_group_members="$(getent group docker 2>/dev/null | cut -d: -f4 || true)"
  if [[ "${KINGO_GROUP_REEXEC:-0}" != "1" ]] \
    && [[ ",${docker_group_members}," == *",${current_user},"* ]] \
    && command -v sg >/dev/null 2>&1; then
    printf -v reexec_command '%q ' "$repo_dir/kingo" "$@"
    exec sg docker -c "KINGO_GROUP_REEXEC=1 $reexec_command"
  fi

  echo "Your account cannot access Docker yet." >&2
  echo "Repair it once with: sudo usermod -aG docker ${current_user}" >&2
  echo "Then log out and back in, or reboot Ubuntu." >&2
  exit 1
fi

if [[ ! -f .env ]]; then
  "$repo_dir/scripts/generate-env.sh"
fi
# Values generated by this project are shell-safe hex strings. Loading .env lets
# the URL and credential commands use any instructor-customized port values.
set -a
# shellcheck disable=SC1091
source .env
set +a

compose=(docker compose --project-directory "$repo_dir")

usage() {
  cat <<'EOF'
Usage: ./kingo COMMAND [arguments]

Commands:
  up              Start or update all classroom services
  down            Stop services, preserving all data
  restart         Restart all services
  status          Show container health and state
  logs [service]  Follow logs for all services or one service
  urls            Show browser URLs and local login information
  credentials     Show database and application credentials from .env
  samples         Load/retry AdventureWorks and WideWorldImportersDW
  psql            Open psql in the warehouse as the postgres administrator
  reset --yes     Delete all Kingo Kit containers and data volumes
EOF
}

host_for_urls="localhost"
if [[ "${BIND_ADDRESS:-127.0.0.1}" == "0.0.0.0" ]]; then
  host_for_urls="$(hostname -I 2>/dev/null | awk '{print $1}')"
  host_for_urls="${host_for_urls:-localhost}"
fi

case "${1:-}" in
  up) "${compose[@]}" up -d --build ;;
  down) "${compose[@]}" down ;;
  restart) "${compose[@]}" restart ;;
  status) "${compose[@]}" ps ;;
  logs) shift; "${compose[@]}" logs --follow --tail=100 "$@" ;;
  urls)
    cat <<EOF
JupyterLab:  http://${host_for_urls}:${JUPYTER_PORT:-8888}  (token: ${JUPYTER_TOKEN})
Langflow:    http://${host_for_urls}:${LANGFLOW_PORT:-7860}
n8n:         http://${host_for_urls}:${N8N_PORT:-5678}  (create your owner on first visit)
Metabase:    http://${host_for_urls}:${METABASE_PORT:-3000}  (${METABASE_ADMIN_EMAIL})
CloudBeaver: http://${host_for_urls}:${CLOUDBEAVER_PORT:-8978}  (${CLOUDBEAVER_ADMIN_USER:-kingo})
PostgreSQL:  ${host_for_urls}:${POSTGRES_PORT:-5432} / warehouse
EOF
    ;;
  credentials)
    cat <<EOF
PostgreSQL database: warehouse
PostgreSQL host from containers: postgres:5432
PostgreSQL host from Ubuntu/host: ${host_for_urls}:${POSTGRES_PORT:-5432}
Student read-only-ish login: student / ${STUDENT_DB_PASSWORD}
Jupyter database login: jupyter / ${JUPYTER_DB_PASSWORD}
Metabase web login: ${METABASE_ADMIN_EMAIL} / ${METABASE_ADMIN_PASSWORD}
CloudBeaver web login: ${CLOUDBEAVER_ADMIN_USER:-kingo} / ${CLOUDBEAVER_ADMIN_PASSWORD}
Jupyter token: ${JUPYTER_TOKEN}
EOF
    ;;
  samples)
    "${compose[@]}" up -d postgres
    "${compose[@]}" --profile samples run --rm --build sample-loader
    "${compose[@]}" --profile samples stop adventureworks-source >/dev/null
    ;;
  psql)
    "${compose[@]}" exec postgres psql -U postgres -d warehouse
    ;;
  reset)
    if [[ "${2:-}" != "--yes" ]]; then
      echo "This permanently deletes all Kingo Kit databases, notebooks stored in Docker volumes, app settings, and workflows." >&2
      echo "Run './kingo reset --yes' only if that is what you want." >&2
      exit 2
    fi
    "${compose[@]}" --profile samples down --volumes --remove-orphans
    ;;
  -h|--help|help|"") usage ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
