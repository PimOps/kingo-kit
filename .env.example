# Kingo Kit classroom defaults. Copy this file to .env (the bootstrap script does
# this automatically and replaces all CHANGE_ME values with random passwords).
COMPOSE_PROJECT_NAME=kingo-kit
TZ=Asia/Seoul

# Keep services local by default. Use 0.0.0.0 only when the Ubuntu machine is a
# VM/remote host and its firewall/network is configured appropriately.
BIND_ADDRESS=127.0.0.1

# Host ports
POSTGRES_PORT=5432
JUPYTER_PORT=8888
LANGFLOW_PORT=7860
N8N_PORT=5678
METABASE_PORT=3000
CLOUDBEAVER_PORT=8978

# Pinned classroom-tested images. Instructors can update these in one place.
POSTGRES_BASE_IMAGE=pgvector/pgvector:pg17
POSTGRES_IMAGE=kingo-kit-postgres:pg17
ADVENTUREWORKS_IMAGE=chriseaton/adventureworks:postgres-16
# Microsoft's public Fabric tutorial-data container. This can be overridden if
# Microsoft relocates the sample data again.
WWI_CONTAINER_URL=https://fabrictutorialdata.blob.core.windows.net/sampledata
LANGFLOW_IMAGE=langflowai/langflow:latest
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
METABASE_IMAGE=metabase/metabase:v0.63.x
CLOUDBEAVER_IMAGE=dbeaver/cloudbeaver:26
JUPYTER_BASE_IMAGE=quay.io/jupyter/minimal-notebook:python-3.12

# Database administrator and per-application accounts
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
N8N_DB_PASSWORD=CHANGE_ME_N8N
LANGFLOW_DB_PASSWORD=CHANGE_ME_LANGFLOW
LANGGRAPH_DB_PASSWORD=CHANGE_ME_LANGGRAPH
METABASE_DB_PASSWORD=CHANGE_ME_METABASE
CLOUDBEAVER_DB_PASSWORD=CHANGE_ME_CLOUDBEAVER
JUPYTER_DB_PASSWORD=CHANGE_ME_JUPYTER
STUDENT_DB_PASSWORD=CHANGE_ME_STUDENT

# Web application accounts
JUPYTER_TOKEN=CHANGE_ME_JUPYTER_TOKEN
LANGFLOW_SECRET_KEY=CHANGE_ME_LANGFLOW_SECRET
N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION
METABASE_ADMIN_EMAIL=student@kingo.local
METABASE_ADMIN_PASSWORD=CHANGE_ME_METABASE_ADMIN
CLOUDBEAVER_ADMIN_USER=kingo
CLOUDBEAVER_ADMIN_PASSWORD=CHANGE_ME_CLOUDBEAVER_ADMIN
